# Local dev / build-time values. This file is gitignored — it will NOT be
# committed or pushed. For the actual Netlify deployment, set the same
# variable names in Netlify's dashboard: Site configuration -> Environment
# variables (Vite bakes these in at build time, so they must exist there,
# not just in this local file).

VITE_GOOGLE_CLIENT_ID=47691925303-4iaff30938g51rf3of0tfts1bq9ksf48.apps.googleusercontent.com

# NOTE: this points the frontend at its own Netlify domain. Netlify only
# serves this static site — it does not run backend/app.py (Python/Flask).
# So calls like /api/auth/google, /api/session, /api/data will 404 here
# unless you deploy backend/app.py separately and point this at THAT URL.
# Google sign-in on the frontend still works either way (see explanation
# below) — this only affects cloud sync / auto-login / the AI coach chat.
VITE_API_BASE_URL=https://fitpose-ai.netlify.app
