
# Fill these in locally in a real `backend/.env` file (already gitignored).
# NEVER commit real values here — this .example file is meant to be checked
# into version control as a template only.
FIRESTORE_PROJECT_ID=your-gcp-project-id
SESSION_SECRET=replace-with-a-long-random-string
OPENAI_API_KEY=sk-...your-real-key...
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json


# Cost-sensitive current OpenAI model. You can override this if your account
# uses another model.
OPENAI_MODEL=gpt-5.6-luna

# Assistant Voice (mic input on the AI Coach chat) — optional overrides.
# Reuses OPENAI_API_KEY above; no separate credential is required.
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
