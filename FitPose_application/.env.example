# Copy this file to `.env` and fill in a real value, then restart `npm run dev`.

# Required for the "Continue with Google" button on the sign-in page.
# Create it at https://console.cloud.google.com/apis/credentials
#   1. Create (or select) a project.
#   2. "Create Credentials" -> "OAuth client ID" -> Application type: "Web application".
#   3. Under "Authorized JavaScript origins" add the URL(s) you run the app from,
#      e.g. http://localhost:5173 for `npm run dev`, and your real domain for production.
#   4. Copy the generated Client ID (ends in .apps.googleusercontent.com) below.
# No client secret is needed — this app only uses the browser-side OAuth token flow.
# The Client ID itself is not a secret (it ends up in the public JS bundle
# either way), so it's safe to keep here and in Netlify's env var settings.
VITE_GOOGLE_CLIENT_ID=47691925303-4iaff30938g51rf3of0tfts1bq9ksf48.apps.googleusercontent.com

# Optional: base URL of the backend in backend/app.py (e.g.
# http://localhost:5000). When set, and when the backend has Google Cloud
# credentials configured (see backend/.env.example), Google-linked accounts'
# workout data is persisted to Google Cloud and the site can automatically
# sign a returning person back in using a stored session token. Leave this
# blank to keep using local (per-browser) storage only, as before.
#
# This same URL also enables the real, OpenAI-backed "AI Coach" chat (see
# backend/ai_coach.py) once the backend has OPENAI_API_KEY set — otherwise
# the chat automatically uses its built-in on-device rule-based coach, no
# setup required.
#
# IMPORTANT: Netlify only hosts this static frontend — it cannot run
# backend/app.py (a Python/Flask/OpenCV server). Do NOT point this at your
# own Netlify URL. Either:
#   - leave this blank to run fully client-side (Google sign-in still
#     works; workout data just stays in the browser's local storage), or
#   - deploy backend/app.py to a Python host (Render, Railway, Fly.io,
#     Cloud Run, etc.) and put THAT service's URL here instead.
VITE_API_BASE_URL=
